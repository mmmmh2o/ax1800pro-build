# ============================================================
# 预置 A: Lean LEDE (coolsnowwolf/lede @ master)
# 京东云 AX1800 Pro (RE-SS-01 / IPQ6000 / 1GB)
#
# 特点:
#   - opkg 包管理器（与你笔记里所有命令习惯一致）
#   - Lua LuCI（自写页面 bugs3.lua 最兼容）
#   - NSS 硬件加速（qca-nss-dp/drv/ssdk/ecm + nss-firmware-ipq6018）
#   - 内核 6.12（testing 6.18）
#   - DTS 含 ipq6018-512m.dtsi：只缩小 WiFi 固件保留区(55MB)，
#     不限制总内存 —— 1GB 由 U-Boot 传入，自动识别
#
# 所有符号已对照 coolsnowwolf/lede@master 核实。
# ============================================================

# ---------- 目标设备 ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# ---------- 基础系统 ----------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-advanced-reboot=y

# ---------- NSS 硬件加速（Lean 默认包，显式写出便于校验）----------
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_nss-firmware-ipq6018=y

# ---------- 无线 ----------
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01=y
CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_wpad-openssl=y

# ---------- USB 手机网络共享 ----------
# Sony 手机 (VID 0x0fce) 走标准 Android RNDIS (EF/04/01)；
# 内核 5.4+ 的 rndis_host 原生支持，无需任何补丁
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usb-modeswitch=y

# ---------- 文件系统 ----------
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ---------- 截图服务（Lean 生态）----------
# 代理: ssr-plus 来自 helloworld feed(Lean 默认已挂)，openclash 在 Lean luci 里
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-turboacc=y
# iStore 应用商店：刷好后用户可从商店自装易有云/DDNSTO/wolplus/KMS/时间控制等
# （这些第三方应用已按用户要求摘除，iStore 商店里都有）
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_ua3f=y
# 内网与工具
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-app-arpbind=y

# ---------- 存储 ----------
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_partx-utils=y

# ---------- 运维 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_iperf3=y

# ---------- 明确不要 ----------
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
