# ============================================================
# 京东云 AX1800 Pro (RE-SS-01 / IPQ6000 / 1GB) 云端编译配置
#
# 源码树: VIKINGYFY/immortalwrt @ main
#   - 完整 NSS 硬件加速栈（20+ 模块，含 PPPoE/VLAN/GRE/L2TP/tunipip6）
#   - 内核 6.18
#   - apk 包管理器（不再是 opkg）
#
# 内存: DTS 不写死容量，由 U-Boot 传入，1GB 自动识别。
#       该分支用 ipq6018.dtsi 默认布局（非 512m 限制版），
#       1GB 可完整使用，不会浪费。
#
# 所有符号均已对照 VIKINGYFY/immortalwrt@main 源码核实。
# CI 会用 scripts/verify-config.sh 再校验一遍。
#
# 用法: cp configs/seed.config .config && make defconfig
# ============================================================

# ---------- 目标设备 ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# 首次刷机必须靠 initramfs 从 U-Boot 引导
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# ---------- 基础系统 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-advanced-reboot=y
CONFIG_PACKAGE_luci-theme-argon=y
# Lua 插件兼容层：截图里多数插件是 Lua 写的，必需
CONFIG_PACKAGE_luci-compat=y

# ---------- 无线（缺 BDF 会导致 WiFi 起不来）----------
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01=y
# 本分支的 6018 固件包名带 -ddwrt 后缀，且已是 ipq60xx 默认包
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_wpad-openssl=y

# ---------- NSS 硬件加速 ----------
# 分支默认已含全套，这里只写名字以便校验
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_nss-firmware=y

# ---------- USB 手机网络共享（你的核心需求）----------
# 你的手机是 Sony (VID 0x0fce)，走标准 Android RNDIS (EF/04/01)。
# 内核 5.4+ 的 rndis_host 已原生包含 USB_CLASS_MISC(0xef),4,1 条目，
# 所以【不需要】再像老系统那样手工 patch .ko 二进制。
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usb-modeswitch=y

# ---------- 文件系统（U 盘 / USB 硬盘挂载）----------
# 注意：本分支 ntfs 驱动包名是 kmod-fs-ntfs3
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ---------- 截图里的服务，全部编译进固件 ----------
# 代理
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-ssr-plus=y
# UA3F 包名是小写 ua3f；它不带 LuCI 界面（原来就没有）
CONFIG_PACKAGE_ua3f=y
# 内网服务
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-wolplus=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_xupnpd=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-timecontrol=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-linkease=y
CONFIG_PACKAGE_luci-app-control-webrestriction=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-app-arpbind=y

# ---------- 存储与分区工具 ----------
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_partx-utils=y

# ---------- 运维便利 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_iperf3=y

# ---------- 明确不要 ----------
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
